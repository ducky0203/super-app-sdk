{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "lib",
    "module": "CommonJS",
    "target": "ES2019",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "lib", "src/examples/**"]
}
